# Optional AI review (Streamlit tab "AI review", CLI --ai-review).
# Copy to .env and fill in. .env is git-ignored; never commit a real key.
# Without ANTHROPIC_API_KEY the AI review is disabled and everything else works as before.
# Install the provider SDK first: pip install -e ".[llm]"

# LLM provider (only "anthropic" is implemented)
SRA_LLM_PROVIDER=anthropic

# Model ID
SRA_LLM_MODEL=claude-opus-5-5

# API key from https://platform.claude.com (leave empty to disable the AI review)
ANTHROPIC_API_KEY=

# Timeout per request in seconds, and SDK retries on timeouts, rate limits and server errors.
# Worst-case waiting time is about timeout x (retries + 1).
SRA_LLM_TIMEOUT_SECONDS=90
SRA_LLM_MAX_RETRIES=2

# Upper bound for the answer length
SRA_LLM_MAX_TOKENS=16000
